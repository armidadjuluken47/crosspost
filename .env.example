DATABASE_URL=postgresql://postgres:postgres@localhost:5432/crosspost

# WaveSpeed (video pipeline — use fixture mode for local dev)
WAVESPEED_API_KEY=
WAVESPEED_API_BASE_URL=https://api.wavespeed.ai
WAVESPEED_POLL_INTERVAL_MS=3000
WAVESPEED_MAX_POLL_ATTEMPTS=120
WAVESPEED_VIDEO_MAX_POLL_ATTEMPTS=240
WAVESPEED_REQUEST_TIMEOUT_MS=120000
WAVESPEED_SUBMIT_TIMEOUT_MS=180000
WAVESPEED_MAX_CONCURRENT_JOBS=4

# OpenAI (Whisper transcription + GPT captions/hashtags — Phase 1)
# CONTENT_AI_MODE=fixture skips Whisper/GPT (use while testing WaveSpeed video)
# CONTENT_AI_MODE=api uses OpenAI Whisper + GPT for real captions from the video
CONTENT_AI_MODE=api
OPENAI_API_KEY=

# Cloudflare R2 (optional for local — use local storage below)
R2_ACCOUNT_ID=
R2_ACCESS_KEY=
R2_SECRET_KEY=
R2_BUCKET_NAME=
# R2_PUBLIC_BASE_URL=https://your-bucket.r2.dev

# Apify (Instagram / TikTok / YouTube intake)
APIFY_TOKEN=
APIFY_INSTAGRAM_ACTOR_ID=apify~instagram-reel-scraper
APIFY_INSTAGRAM_TASK_ID=
APIFY_TIKTOK_ACTOR_ID=clockworks~tiktok-scraper
APIFY_YOUTUBE_ACTOR_ID=streamers~youtube-scraper
APIFY_YOUTUBE_DOWNLOADER_ACTOR_ID=streamers~youtube-video-downloader
APIFY_SYNC_TIMEOUT_SECONDS=300
INGESTION_PROVIDER_MODE=fixture
# Set to `api` after adding APIFY_TOKEN to enable live multi-platform intake / URL import
# INGESTION_PROVIDER_MODE=api

IMAGE_PROVIDER_MODE=fixture
VIDEO_PROVIDER_MODE=fixture
ASSET_STORAGE_MODE=local
LOCAL_ASSET_STORAGE_DIR=.crosspost-storage
# Browser-relative path for UI. WaveSpeed gets data URIs for local assets automatically.
LOCAL_ASSET_PUBLIC_BASE_URL=/api/assets

RUN_EXECUTION_MODE=inline
WORKER_LOOP=false
WORKER_POLL_INTERVAL_MS=5000

FFMPEG_PATH=

# Optional delivery integrations (from AMVE)
DRIVE_SA_JSON_BASE64=
DRIVE_ROOT_FOLDER_ID=
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=

# Admin ops dashboard (/admin) — leave empty for open local dev
DASHBOARD_PASSWORD=
OPERATOR_PASSWORD=
DAILY_SPEND_CAP_CENTS=0

REDIS_URL=

SENTRY_DSN=
SENTRY_ENVIRONMENT=development

# Stripe (creator billing — Phase 1 UI)
STRIPE_SECRET_KEY=
STRIPE_WEBHOOK_SECRET=
STRIPE_PRICE_MONTHLY=
STRIPE_PRICE_YEARLY=

# Akool express face swap (optional — enables Express tier on /create)
AKOOL_API_TOKEN=
AKOOL_API_BASE_URL=https://openapi.akool.com

# Public app URL for email links + Akool asset fetch (use ngrok in local dev for Express)
APP_BASE_URL=http://localhost:3000

# Auto-post to social (optional — hides the feature when unset)
# Register apps at https://console.cloud.google.com (YouTube Data API v3) and
# https://developers.tiktok.com, then set the OAuth redirect URIs to:
#   {APP_BASE_URL}/api/creator/social/youtube/callback
#   {APP_BASE_URL}/api/creator/social/tiktok/callback
# SOCIAL_TOKEN_ENC_KEY must be a base64-encoded 32-byte key. Generate one with:
#   node -e "console.log(require('crypto').randomBytes(32).toString('base64'))"
YOUTUBE_OAUTH_CLIENT_ID=
YOUTUBE_OAUTH_CLIENT_SECRET=
TIKTOK_CLIENT_KEY=
TIKTOK_CLIENT_SECRET=
# Instagram Reels — Meta app (Facebook Login + Instagram Graph). Professional IG + Page required.
# Redirect: {APP_BASE_URL}/api/creator/social/instagram/callback
META_APP_ID=
META_APP_SECRET=
SOCIAL_TOKEN_ENC_KEY=

# Resend — project-ready + workspace invite emails (stubs to console without key)
# RESEND_API_KEY=
EMAIL_FROM=CrossPost <onboarding@resend.dev>

GOOGLE_APPLICATION_CREDENTIALS=../../service-account.json

NODE_ENV=development
