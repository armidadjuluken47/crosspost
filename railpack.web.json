{
  "$schema": "https://schema.railpack.com",
  "provider": "node",
  "packages": {
    "node": "22"
  },
  "buildAptPackages": ["ffmpeg"],
  "steps": {
    "build": {
      "commands": [
        "corepack enable",
        "corepack pnpm install",
        "corepack pnpm build:web"
      ]
    }
  },
  "deploy": {
    "startCommand": "corepack pnpm start:web"
  }
}
